#Rev
# Copy to .env and edit. Used by docker-compose.

# MySQL — system configuration + users
SM_DB_NAME=solar_monitor
SM_DB_USER=solar
SM_DB_PASSWORD=solar
SM_DB_ROOT_PASSWORD=change-me-root

# MongoDB — time-series solar data
SM_MONGO_DB=solar_monitor
SM_MONGO_USER=solar
SM_MONGO_PASSWORD=solar

# External monitoring (Prometheus /metrics, JSON /healthz for Grafana/New Relic)
# SM_METRICS_TOKEN: if set, /metrics and /healthz require ?token=... or
#   "Authorization: Bearer <token>". Leave blank to allow open scraping on a LAN.
SM_METRICS_TOKEN=
# Seconds without a successful read before an inverter is reported "offline".
SM_OFFLINE_TIMEOUT_SECONDS=120

# Inverter protocol family hint (skips flaky GoodWe auto-detect). ES for GW####ES.
SM_GOODWE_FAMILY=
SM_GOODWE_TIMEOUT=2
# GitHub auto-update (Settings -> Updates)
SM_GITHUB_REPO=dtitsolutions/solar-tracker
SM_GITHUB_BRANCH=main
SM_GITHUB_TOKEN=
# Absolute host path where this project is deployed. The in-stack 'updater'
# sidecar uses it to git pull + rebuild when you click "Update now".
SM_APP_DIR=/opt/solar-tracker
